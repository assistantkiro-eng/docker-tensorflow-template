# TensorFlow Serving Configuration
# Production-ready configuration for model serving

model_config_list {
  config {
    name: "tensorflow-model"
    base_path: "/models/tensorflow-model"
    model_platform: "tensorflow"
    
    # Model version policy
    model_version_policy {
      specific {
        versions: 1
      }
    }
    
    # Performance tuning
    model_warmup_options {
      batch_size: 32
      num_request_iterations: 10
    }
  }
}

# Server configuration
port: 8500
rest_api_port: 8501

# Performance settings
num_load_threads: 4
num_unload_threads: 4
max_num_load_retries: 5
load_retry_interval_micros: 60000000

# Monitoring
enable_model_warmup: true
enable_batching: true
batching_parameters {
  max_batch_size { value: 1024 }
  batch_timeout_micros { value: 1000 }
  max_enqueued_batches { value: 1000000 }
  num_batch_threads { value: 8 }
}

# File system polling
file_system_poll_wait_seconds: 30

# gRPC settings
grpc_channel_arguments {
  # Keepalive settings
  "grpc.keepalive_time_ms": 20000
  "grpc.keepalive_timeout_ms": 10000
  "grpc.http2.max_pings_without_data": 0
  "grpc.keepalive_permit_without_calls": 1
}

# Logging
log_collector_config {
  type: "memory"
  memory {
    max_num_entries: 1000
  }
}